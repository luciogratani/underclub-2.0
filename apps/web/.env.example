# --- Browser (exposed to the client bundle: public values only) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server only (Vercel Functions in api/, and the Vite dev middleware) ---
# Never prefix these with VITE_: they must not reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Absolute site URL: base of the email links and the allowed POST Origin.
# Dev default: http://<host of the dev server>.
PUBLIC_SITE_URL=https://underclub.it
# Extra allowed origins, comma separated (e.g. https://www.underclub.it).
ALLOWED_ORIGINS=
# resend | console. Default: resend on any Vercel deployment, console locally.
# console prints the links in the logs and is refused on Vercel (preview too).
# The dev server always uses console.
EMAIL_TRANSPORT=
RESEND_API_KEY=
# Sender on the domain verified in Resend (example address).
EMAIL_FROM="Underclub <tickets@reservations.underclub.it>"
# Optional Reply-To. The sending subdomain has no inbox: replies to a ticket
# email go here (e.g. info@underclub.it, once that mailbox has its MX).
EMAIL_REPLY_TO=

# Secrets, required on every Vercel deployment (preview included). Generate
# each one separately with:   openssl rand -base64 48
# Locally (dev server, tests) dev-only defaults are used when they are empty.
# Derives the ticket token of every booking confirmed by the endpoints (passed
# to the DB on each call, never stored there). At least 32 characters.
# Rotating it does not break the links already emailed (the DB keeps their
# hash), but "my bookings" can no longer rebuild the ticket link of bookings
# confirmed before the change (they fall back to "the link is in your email").
TICKET_SECRET=
# Keys the HMAC of the client IP used by the per-IP limits: the database only
# ever sees the hash. At least 32 characters. Rotating it just resets the limits.
IP_HASH_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup
# (daily, see vercel.json). At least 16 characters.
CRON_SECRET=

# --- Local only ---
# Dev server: talk to a local Postgres (supabase/tests/run.sh --keep prints
# the URL) instead of Supabase. SUPABASE_* are then not needed.
DEV_PG_URL=
# Integration tests read TEST_PG_URL from the shell, not from this file:
#   TEST_PG_URL=postgres://postgres@127.0.0.1:55432/postgres pnpm --filter web test
