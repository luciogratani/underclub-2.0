{
  // Server code: Vercel Functions (api/) and their logic (server/).
  // Runs as Node ESM ("type": "module"): relative imports need explicit .js
  // extensions (checked by server/imports.test.ts; NodeNext resolution would
  // enforce it too, but it rejects the extensionless imports inside
  // @underclub/shared's raw .ts source). verbatimModuleSyntax keeps that
  // package to `import type` only.
  // `undici-types` is a direct devDependency on purpose: Vercel type-checks
  // the functions without following pnpm's symlinks, so it cannot reach the
  // copy nested under @types/node, and Request/Response would lose every
  // member (the "Property 'headers' does not exist" errors in build logs).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["server", "api", "middleware.ts"]
}
